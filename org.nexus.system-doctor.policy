<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>Nexus System Doctor</vendor>
  <vendor_url>https://example.invalid/nexus-system-doctor</vendor_url>

  <action id="org.nexus.system-doctor.run-helper">
    <description>Run Nexus System Doctor diagnostics and repairs</description>
    <message>Administrator rights are required to read disk health data or apply system repairs.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/nexus-system-doctor/privileged-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
