#!/usr/bin/env python3
"""
Nexus System Doctor - privileged helper.

Invoked by pkexec to perform a single, allow-listed administrative action
(run an approved diagnostic command, or write/remove a system configuration
file).  See nexus_doctor/privileged_helper.py for the rules it enforces.
"""

import os
import sys

CANDIDATES = [
    "/opt/nexus-system-doctor/nexus_doctor",
    "/usr/lib/nexus-system-doctor/nexus_doctor",
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "nexus_doctor"),
]

for cand in CANDIDATES:
    if os.path.isdir(cand) and os.path.isfile(os.path.join(cand, "__init__.py")):
        sys.path.insert(0, os.path.dirname(cand))
        break
else:
    sys.stderr.write("privileged-helper: nexus_doctor package not found\n")
    raise SystemExit(127)

from nexus_doctor.privileged_helper import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
